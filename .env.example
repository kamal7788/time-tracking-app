# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/time_tracking?schema=public"

# JWT — REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"

# First-run admin account (created by the seed on container start)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="Administrator"

# Set to "true" to disable public self-registration (admin creates accounts)
DISABLE_PUBLIC_REGISTRATION="false"

# Email (optional — notifications work without it, emails are skipped)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Time Tracking App"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
